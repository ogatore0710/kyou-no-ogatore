<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-C2-2026-07-31-build12-journey2-splash-emoji.md W1-b item7: chara.pngを約25%inset
     で包む(円形マスクで耳が切れるのを防ぐ)。Android 12+のSplashScreen APIは
     windowSplashScreenAnimatedIconの中央だけを円形にトリミングするため、素のchara.pngを
     そのまま渡すと頭の輪郭(耳・髪の跳ね)が切れる。insetで実質40〜50%サイズに収める。 -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/chara"
    android:insetLeft="25%"
    android:insetTop="25%"
    android:insetRight="25%"
    android:insetBottom="25%" />
