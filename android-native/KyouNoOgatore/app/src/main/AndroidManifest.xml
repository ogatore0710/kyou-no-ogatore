<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 見た目パリティ第2弾(TASK-C2-2026-07-26-visual-parity-round2.md §2): 動画サムネイル
         (https://i.ytimg.com/vi/...)・使い方ツアーのミニチュア内サムネイルの読み込みに必要。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- TASK-C2-2026-07-27-offline-banner.md: ConnectivityManager.registerNetworkCallbackで
         接続状態を監視するために必要(通常権限・実行時ダイアログなし)。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- TASK-C2-2026-07-27-local-notifications.md: Android13+で通知を出すための実行時権限。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 再起動でAlarmManagerの予約が消えるため、次回分を再設定するために必要
         (通常権限・実行時ダイアログなし)。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.KyouNoOgatore"
        android:supportsRtl="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KyouNoOgatore"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Step 7b(マスタープラン§6 Step 7b): 記録カード/じまんカードの保存・共有(index.html
             shareCard()相当)で初めて必要になった。Intent.ACTION_SENDで渡すファイルURIは
             file://でなくcontent://である必要がある(Android 7+のFileUriExposedException回避)ため
             FileProviderを使う。共有対象はcacheDir配下のPNGのみに絞る(files-path等は公開しない)。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="jp.ogatore.kyouno.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- TASK-C2-2026-07-27-local-notifications.md: 毎日のおしらせ通知(AlarmManager+
             BroadcastReceiver方式)。exported=falseでアプリ外からの起動は受け付けない。 -->
        <receiver
            android:name=".DailyNotificationReceiver"
            android:exported="false" />
        <!-- 再起動でAlarmManagerの予約が消えるため、次回分を再設定する。BOOT_COMPLETEDは
             システムのみが送信するためexported=trueでも安全。 -->
        <receiver
            android:name=".NotificationBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- GO-H1(ホーム画面ウィジェット・Duolingo式・本人GO 2026-07-28): Phase1=表示専用。
             タップでアプリを開くだけ・ウィジェットからの記録は今回作らない。 -->
        <receiver
            android:name=".widget.KyonoWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kyono_widget_info" />
        </receiver>
    </application>

</manifest>
