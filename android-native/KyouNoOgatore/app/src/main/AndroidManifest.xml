<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 見た目パリティ第2弾(TASK-C2-2026-07-26-visual-parity-round2.md §2): 動画サムネイル
         (https://i.ytimg.com/vi/...)・使い方ツアーのミニチュア内サムネイルの読み込みに必要。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- TASK-C2-2026-07-27-offline-banner.md: ConnectivityManager.registerNetworkCallbackで
         接続状態を監視するために必要(通常権限・実行時ダイアログなし)。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.KyouNoOgatore"
        android:supportsRtl="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KyouNoOgatore">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Step 7b(マスタープラン§6 Step 7b): 記録カード/じまんカードの保存・共有(index.html
             shareCard()相当)で初めて必要になった。Intent.ACTION_SENDで渡すファイルURIは
             file://でなくcontent://である必要がある(Android 7+のFileUriExposedException回避)ため
             FileProviderを使う。共有対象はcacheDir配下のPNGのみに絞る(files-path等は公開しない)。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="jp.ogatore.kyouno.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
