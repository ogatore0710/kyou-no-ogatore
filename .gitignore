# ネイティブ移植(ios-native/android-native)のビルド生成物・ローカル環境依存ファイル
# (マスタープラン2026-07-25。NATIVE-BUILD-GUIDEのgojiai-app実績と同じパターンを踏襲)
# ios-native/verify/ 及び android-native/*/verify/ の検証スクショはあえて追跡対象(alan5への報告用証跡)
ios-native/*/build/
android-native/*/local.properties
android-native/*/.gradle/
android-native/*/build/
android-native/*/app/build/
# SwiftPMのビルド成果物。2026-07-28: パッケージ名を1つずつ列挙する書き方だったため、
# 新設のWidgetCoreだけ穴になり201MB・2341ファイルが混入した。以後は総称で塞ぐ。
ios-native/**/.build/
ios-native/*/SafetyCore/.swiftpm/
ios-native/*/RecordCore/.swiftpm/
ios-native/*/CardCore/.swiftpm/

# Xcodeのユーザー個別UI状態（開いたタブ・カーソル位置などを記録するバイナリ）。
# 2026-07-28時点で19回ぶんの無意味なコミットを生んでいた。バイナリなのでマージできず、
# 2台のMacでeven-syncが同時に拾うと衝突してリポジトリ全体の同期が止まる危険がある。
ios-native/**/xcuserdata/
